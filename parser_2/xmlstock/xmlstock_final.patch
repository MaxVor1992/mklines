+import os
+import time
+import math
+from typing import Dict, Iterable, List, Optional, Tuple
+
+import bs4
+import requests
+from flask_login import current_user
+
+from . import db
+from .for_cache import timed_lru_cache
+from .resultobj import ParsingResult, SingleResult
+from .utils import print_error, print_warning
+
+# Environment variables have priority. Fallback values below are the current XMLStock credentials
+# provided for this project deployment.
+XMLSTOCK_USER_ID = (os.getenv("XMLSTOCK_USER_ID") or "14050").strip()
+XMLSTOCK_API_KEY = (os.getenv("XMLSTOCK_API_KEY") or "44f372573b32c1e7e741e2d903df37eb").strip()
+XMLSTOCK_TIMEOUT = int((os.getenv("XMLSTOCK_TIMEOUT") or "60").strip())
+XMLSTOCK_DOMAIN_YANDEX = (os.getenv("XMLSTOCK_DOMAIN_YANDEX") or "ru").strip() or "ru"
+XMLSTOCK_DOMAIN_GOOGLE = (os.getenv("XMLSTOCK_DOMAIN_GOOGLE") or "com").strip() or "com"
+XMLSTOCK_DEVICE = (os.getenv("XMLSTOCK_DEVICE") or "desktop").strip() or "desktop"
+
+HTTP_RETRY_CODES = {500, 501, 502, 503}
+XML_RETRY_CODES_YANDEX_XML = {"202", "210"}
+XML_RETRY_CODES_YANDEX_LIVE = {"20", "21", "22", "23", "24", "25", "110"}
+XML_RETRY_CODES_GOOGLE = {"20", "21", "22", "23", "24", "25", "110"}
+FORBIDDEN_RESULT_PARENTS = {
+    "topads",
+    "bottomads",
+    "ads",
+    "scroller",
+    "relatedsearches",
+    "relatedquestions",
+    "related",
+}
+
+
+class XmlStockError(RuntimeError):
+    pass
+
+
+class XmlStockResponseError(RuntimeError):
+    def __init__(self, code, message):
+        self.code = str(code) if code is not None else None
+        self.message = message or "Unknown XMLStock error"
+        super(XmlStockResponseError, self).__init__(self.message)
+
+
+class ParsedXmlResponse(object):
+    def __init__(self, items=None, error_code=None, error_message=None):
+        self.items = items or []
+        self.error_code = error_code
+        self.error_message = error_message
+
+
+class XmlStockEndpoints(object):
+    YANDEX_XML = "https://xmlstock.com/yandex/xml/"
+    YANDEX_LIVE = "https://xmlstock.com/yandexlive/xml/"
+    GOOGLE_XML = "https://xmlstock.com/google/xml/"
+
+
+def _credentials():
+    if not XMLSTOCK_USER_ID or not XMLSTOCK_API_KEY:
+        raise XmlStockError("XMLStock credentials are not configured")
+    return XMLSTOCK_USER_ID, XMLSTOCK_API_KEY
+
+
+def _decrement_limit():
+    try:
+        current_user.limits = current_user.limits - 1
+        db.session.commit()
+    except Exception as exc:
+        print_warning("failed to decrement user limit: {0}".format(exc))
+
+
+def _request_with_http_retry(url, params, max_attempts=4):
+    last_error = None
+    for attempt in range(1, max_attempts + 1):
+        try:
+            response = requests.get(url, params=params, timeout=XMLSTOCK_TIMEOUT)
+        except requests.RequestException as exc:
+            last_error = exc
+            if attempt >= max_attempts:
+                raise
+            time.sleep(min(2 * attempt, 8))
+            continue
+
+        if response.status_code in HTTP_RETRY_CODES and attempt < max_attempts:
+            time.sleep(min(2 * attempt, 8))
+            continue
+        return response
+
+    if last_error:
+        raise last_error
+    raise XmlStockError("HTTP request failed without a response")
+
+
+def _parse_xml(text):
+    return bs4.BeautifulSoup(text, "xml")
+
+
+def _extract_error_info(xml_text):
+    soup = _parse_xml(xml_text)
+    error = soup.find("error")
+    if not error:
+        return None, None
+
+    code = (error.get("code") or "").strip()
+    if not code:
+        code_tag = error.find("code")
+        code = code_tag.get_text(" ", strip=True) if code_tag else None
+    message = error.get_text(" ", strip=True) or "Unknown XMLStock error"
+    return code, message
+
+
+def _perform_yandex_xml_request(query, count, region, device=XMLSTOCK_DEVICE):
+    user_id, api_key = _credentials()
+    params = {
+        "user": user_id,
+        "key": api_key,
+        "query": query,
+        "lr": region,
+        "groupby": count,
+        "page": 0,
+        "domain": XMLSTOCK_DOMAIN_YANDEX,
+        "device": device,
+    }
+    _decrement_limit()
+
+    response = None
+    for attempt in range(1, 7):
+        response = _request_with_http_retry(XmlStockEndpoints.YANDEX_XML, params)
+        if response.status_code != 200:
+            return response
+
+        code, message = _extract_error_info(response.text)
+        if code not in XML_RETRY_CODES_YANDEX_XML:
+            return response
+
+        if attempt >= 6:
+            raise XmlStockResponseError(code, message)
+
+        # XMLStock recommends repeating hybrid/asynchronous Yandex XML requests after 5-10 seconds.
+        time.sleep(6 if code == "210" else 10)
+
+    return response
+
+
+def _perform_yandex_live_request(query, region, page, device=XMLSTOCK_DEVICE):
+    user_id, api_key = _credentials()
+    params = {
+        "user": user_id,
+        "key": api_key,
+        "query": query,
+        "lr": region,
+        "page": page,
+        "domain": XMLSTOCK_DOMAIN_YANDEX,
+        "device": device,
+    }
+    _decrement_limit()
+
+    response = None
+    for attempt in range(1, 6):
+        response = _request_with_http_retry(XmlStockEndpoints.YANDEX_LIVE, params)
+        if response.status_code != 200:
+            return response
+
+        code, message = _extract_error_info(response.text)
+        if code not in XML_RETRY_CODES_YANDEX_LIVE:
+            return response
+
+        if attempt >= 5:
+            raise XmlStockResponseError(code, message)
+
+        time.sleep(min(2 * attempt, 8))
+
+    return response
+
+
+def _perform_google_xml_request(query, region, page, device=XMLSTOCK_DEVICE):
+    user_id, api_key = _credentials()
+    params = {
+        "user": user_id,
+        "key": api_key,
+        "query": query,
+        "lr": region,
+        "page": page,
+        "domain": XMLSTOCK_DOMAIN_GOOGLE,
+        "device": device,
+    }
+    _decrement_limit()
+
+    response = None
+    for attempt in range(1, 6):
+        response = _request_with_http_retry(XmlStockEndpoints.GOOGLE_XML, params)
+        if response.status_code != 200:
+            return response
+
+        code, message = _extract_error_info(response.text)
+        if code not in XML_RETRY_CODES_GOOGLE:
+            return response
+
+        if attempt >= 5:
+            raise XmlStockResponseError(code, message)
+
+        time.sleep(min(2 * attempt, 8))
+
+    return response
+
+
+# Process-wide caches. This makes the UI checkbox "Кешировать запросы" behave consistently
+# for repeated keywords across submissions within the configured TTL from parser_app/for_cache.py.
+_cached_yandex_xml_request = timed_lru_cache()(_perform_yandex_xml_request)
+_cached_yandex_live_request = timed_lru_cache()(_perform_yandex_live_request)
+_cached_google_xml_request = timed_lru_cache()(_perform_google_xml_request)
+
+
+class SearchParser(object):
+    def __init__(self, user_requests, engine="yandex_xml", count=10, repeats=1, verbose=True,
+                 region=213, docache=True):
+        self.user_requests = tuple(user_requests)
+        self.engine = engine
+        self.region = int(region)
+        self.count = int(count)
+        self.repeats = int(repeats)
+        self.verbose = verbose
+        self.docache = docache
+        self.delay_repeats = 0.01
+
+    def _request_yandex_xml(self, query):
+        if self.docache:
+            return _cached_yandex_xml_request(query, self.count, self.region)
+        return _perform_yandex_xml_request(query, self.count, self.region)
+
+    def _request_yandex_live(self, query, page):
+        if self.docache:
+            return _cached_yandex_live_request(query, self.region, page)
+        return _perform_yandex_live_request(query, self.region, page)
+
+    def _request_google_xml(self, query, page):
+        if self.docache:
+            return _cached_google_xml_request(query, self.region, page)
+        return _perform_google_xml_request(query, self.region, page)
+
+    @staticmethod
+    def _clean_text(tag):
+        if not tag:
+            return ""
+        return " ".join(tag.get_text(" ", strip=True).split())
+
+    @staticmethod
+    def _has_forbidden_parent(node):
+        parent = node.parent
+        while parent is not None and isinstance(parent, bs4.Tag):
+            if (parent.name or "").lower() in FORBIDDEN_RESULT_PARENTS:
+                return True
+            parent = parent.parent
+        return False
+
+    def _extract_result_from_node(self, node):
+        target = node.find("doc") or node.find("result") or node.find("item") or node
+        url_tag = target.find("url") or target.find("link")
+        title_tag = target.find("title") or target.find("headline") or target.find("name")
+
+        url = self._clean_text(url_tag)
+        title = self._clean_text(title_tag) or url
+
+        if not url:
+            return None
+        if not url.startswith(("http://", "https://")):
+            return None
+        return url, title
+
+    def _iter_candidate_nodes(self, soup):
+        selectors = [
+            "results grouping group",
+            "response results grouping group",
+            "organic result",
+            "organic item",
+            "organic doc",
+            "results result",
+            "result",
+            "item",
+            "doc",
+            "group",
+        ]
+        seen = set()
+        for selector in selectors:
+            for node in soup.select(selector):
+                node_id = id(node)
+                if node_id in seen:
+                    continue
+                seen.add(node_id)
+                if self._has_forbidden_parent(node):
+                    continue
+                yield node
+
+    def _parse_xmlstock_response(self, response):
+        if response.status_code != 200:
+            return ParsedXmlResponse([], str(response.status_code), "HTTP {0}".format(response.status_code))
+
+        soup = _parse_xml(response.text)
+        error = soup.find("error")
+        if error:
+            code = (error.get("code") or "").strip() or None
+            message = error.get_text(" ", strip=True) or "XMLStock returned an error"
+            return ParsedXmlResponse([], code, message)
+
+        items = []
+        seen_urls = set()
+        for node in self._iter_candidate_nodes(soup):
+            extracted = self._extract_result_from_node(node)
+            if not extracted:
+                continue
+            url, title = extracted
+            if url in seen_urls:
+                continue
+            seen_urls.add(url)
+            items.append((url, title))
+            if len(items) >= self.count:
+                break
+
+        return ParsedXmlResponse(items, None, None)
+
+    @staticmethod
+    def _append_results(target_dict, page_items, page_number):
+        start_position = page_number * 10 + 1
+        for index, item in enumerate(page_items, start=start_position):
+            url, title = item
+            target_dict.setdefault(SingleResult(url, title), []).append(index)
+
+    def _run_single_query(self, text):
+        collected = {}
+        last_error_message = None
+
+        for _ in range(self.repeats):
+            try:
+                if self.engine == "yandex_xml":
+                    parsed = self._parse_xmlstock_response(self._request_yandex_xml(text))
+                    if parsed.items:
+                        self._append_results(collected, parsed.items, 0)
+                    else:
+                        last_error_message = parsed.error_message
+                else:
+                    pages = int(math.ceil(self.count / 10.0))
+                    for page in range(pages):
+                        if self.engine == "yandex_live":
+                            response = self._request_yandex_live(text, page)
+                        elif self.engine == "google_xml":
+                            response = self._request_google_xml(text, page)
+                        else:
+                            raise XmlStockError("Unsupported XMLStock engine: {0}".format(self.engine))
+
+                        parsed = self._parse_xmlstock_response(response)
+                        if parsed.items:
+                            self._append_results(collected, parsed.items, page)
+                        else:
+                            last_error_message = parsed.error_message
+                            break
+
+                        if len(collected) >= self.count or len(parsed.items) < 10:
+                            break
+            except XmlStockResponseError as exc:
+                last_error_message = exc.message
+            except Exception as exc:
+                last_error_message = str(exc)
+                print_error(last_error_message)
+
+            time.sleep(self.delay_repeats)
+
+        if not collected:
+            collected[SingleResult(last_error_message or "Для заданного поискового запроса отсутствуют результаты поиска.",
+                                   "error")] = [0]
+
+        for result in list(collected.keys()):
+            collected[result] = sum(collected[result]) / float(len(collected[result]))
+
+        return sorted(collected.items(), key=lambda x: x[1])
+
+    def run_parse(self):
+        results = ParsingResult(self.engine)
+        for text in self.user_requests:
+            results.result[text] = self._run_single_query(text)
+        return results
